{
  "name": "powergrid-tycoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A power grid tycoon simulation game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "smoke": "node scripts/smoke.mjs",
    "build:single": "vite build --config vite.single.config.ts",
    "bundle": "npm run build:single && node scripts/bundleSingleFile.mjs",
    "bundle:artifact": "npm run bundle && node scripts/bundleArtifact.mjs dist-single/powergrid-tycoon.fragment.html",
    "check:pages": "node scripts/checkPagesPaths.mjs",
    "verify:pages": "node scripts/verifySubpath.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
